# === Базовое ===
PORT=8080
# Внешний URL сайта (https). Сайт работает в РФ без VPN: фронт на Cloudflare Pages, API за Cloudflare-прокси.
BASE_URL=https://vpnstar.example.ru
# Секрет для подписи cookie/sessions (долгие случайные символы)
SECRET_KEY=replace-with-64-random-chars

# === Платежи ===
# mock  — тестовый режим: «Я оплатил» активировал платёж мгновенно
# yookassa — боевой: ЮKassa (СБП QR + карты РФ)
PAYMENT_MODE=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_IS_SANDBOX=true

# === Telegram ===
TG_BOT_TOKEN=
TG_SUPPORT_USERNAME=@vpnstar_support
# Ссылка на Telegram-канал сервиса
TG_CHANNEL_URL=https://t.me/vpnstar_channel

# === ИИ-поддержка (любой OpenAI-совместимый API: OpenRouter, Groq, OpenAI, LM-Studio...) ===
# Пусто = бот отвечает по заранее написанному FAQ
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# === Email-уведомления (необязательно; без SMTP уведомления идут только в TG) ===
MAIL_FROM="VpnStar <no-reply@vpnstar.example.ru>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# === VPN-провайдер ===
# Если XUI_BASE пустой — mock-провайдер (демо-профили VLESS Reality)
# Реально: API панели 3x-ui на твоём VPS (Oracle Cloud, 0 руб.)
XUI_BASE=
XUI_USER=
XUI_PASSWORD=
# Демо-хост для mock-профилей
VPN_DEMO_HOST=203.0.113.10

# === Админка (токен для возвратов и ручных операций) ===
ADMIN_TOKEN=
