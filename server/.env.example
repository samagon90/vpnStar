# === Базовое ===
PORT=8080
# Внешний URL сайта (https). Сайт работает в РФ без VPN: фронт на Cloudflare Pages, API за Cloudflare-прокси.
BASE_URL=https://sonicvpn.example.ru
# Секрет для подписи cookie/sessions (долгие случайные символы)
SECRET_KEY=replace-with-64-random-chars

# === Платежи ===
# mock  — тестовый режим: «Я оплатил» активировал платёж мгновенно
# yookassa — боевой: ЮKassa (СБП QR + карты РФ)
PAYMENT_MODE=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_IS_SANDBOX=true

# === Telegram ===
TG_BOT_TOKEN=
TG_SUPPORT_USERNAME=@sonicvpn_support
# Ссылка на Telegram-канал сервиса
TG_CHANNEL_URL=https://t.me/sonicvpn_channel

# === ИИ-поддержка (бесплатный LLM, любой OpenAI-совместимый API) ===
# Пусто = бот отвечает по заранее написанному FAQ (и так работает в mock-режиме).
# Ключи берутся БЕЗ карты:
#   Groq (рекомендую, быстрый):   https://console.groq.com  -> API Keys
#     AI_API_BASE=https://api.groq.com/openai/v1
#     AI_API_KEY=gsk_xxx
#     AI_MODEL=llama-3.3-70b-versatile      # 30 req/min, ~1000 req/день бесплатно
#   OpenRouter:                  https://openrouter.ai  -> Keys (модели с суффиксом :free)
#     AI_API_BASE=https://openrouter.ai/api/v1
#     AI_API_KEY=sk-or-v1-xxx
#     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free   # ~50 req/день (1000 после $10 на аккаунт)
#   Google Gemini (AI Studio):   https://aistudio.google.com -> Get API key
#     AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_API_KEY=AIzaSyXxx
#     AI_MODEL=gemini-2.0-flash
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# === Email-уведомления (необязательно; без SMTP уведомления идут только в TG) ===
MAIL_FROM="Sonic VPN <no-reply@sonicvpn.example.ru>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# === VPN-провайдер ===
# Если XUI_BASE пустой — mock-провайдер (демо-профили VLESS Reality)
# Реально: API панели 3x-ui на VPN-сервере. Полный «Access URL» из `x-ui settings`,
# но БЕЗ финального слэша. Пример: https://185.125.102.135:20461/3dtIfnbTYAw5E0rNtB
# (self-signed SSL панели поддерживается: отдельный undici-agent без проверки сертификата)
XUI_BASE=
XUI_USER=
XUI_PASSWORD=
# Демо-хост для mock-профилей
VPN_DEMO_HOST=203.0.113.10

# === Админка (токен для возвратов и ручных операций) ===
ADMIN_TOKEN=
